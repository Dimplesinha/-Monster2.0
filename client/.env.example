VITE_API_BASE_URL=http://localhost:5000/api

# ── Cloud Resume Import (optional) ─────────────────────────────────
# Leave blank in development. When blank, clicking a cloud button shows
# a "not configured" notice and falls back to device upload.

# Google Drive Picker API key — https://developers.google.com/drive/picker
VITE_GOOGLE_DRIVE_PICKER_KEY=

# Dropbox App key — https://www.dropbox.com/developers/apps
VITE_DROPBOX_APP_KEY=

# Microsoft OneDrive client ID — https://learn.microsoft.com/en-us/onedrive/developer
VITE_ONEDRIVE_CLIENT_ID=
