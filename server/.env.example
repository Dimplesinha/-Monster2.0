# ── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────
# MongoDB Atlas: create a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/jobboard?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ── SMTP Email (Nodemailer) ───────────────────────────────────────────
#
# Leave SMTP_HOST / SMTP_USER / SMTP_PASS blank in development.
# When blank, the server logs the verification code to the console
# instead of sending an email — you can still complete the full signup
# flow without any email setup.
#
# In production, all three SMTP_* vars must be set or the server will
# return 500 on /auth/register and /auth/resend-verification.
#
# ── Free Gmail setup ──────────────────────────────────────────────────
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:
#      myaccount.google.com → Security → App passwords
#      Select "Mail" → Generate → copy the 16-character code
# 3. Fill in the vars below and restart the server.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Monster <your_email@gmail.com>"

# Set to false to suppress console code logging when SMTP sends successfully
EMAIL_DEV_LOG=true
